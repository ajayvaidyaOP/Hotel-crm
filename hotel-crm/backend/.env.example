# ---------------------------------------------------------------------------
# Hotel CRM backend - copy to .env (or export in your shell / container env)
# ---------------------------------------------------------------------------

# Active Spring profile: dev (seeds demo data) | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- MySQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hotel_crm
DB_USERNAME=hotel_crm
DB_PASSWORD=change-me
DB_POOL_SIZE=15

# --- Security ------------------------------------------------------------
# MUST be changed: at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-in-production-this-secret-must-be-at-least-32-bytes-long-00
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
# 32 byte AES key used to encrypt guest ID proofs at rest
APP_ENCRYPTION_KEY=dev-only-encryption-key-32bytes!!

# Comma separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600

# --- Demo data -----------------------------------------------------------
# Flyway also loads classpath:db/seed when enabled (5 hotels, rooms, staff, bookings)
APP_SEED_ENABLED=true

LOG_LEVEL=INFO
